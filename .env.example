# ============================================================
# ForgeOS VPS — Environment Configuration
# ============================================================
# Copy to .env and fill in values before running install.sh
# NEVER commit .env to git

# ── VPS Connection ──────────────────────────────────────────
VPS_HOST=64.181.211.201
VPS_USER=ubuntu
VPS_SSH_KEY=~/.ssh/id_rsa

# ── Tailscale ───────────────────────────────────────────────
TAILSCALE_AUTHKEY=tskey-auth-XXXXX
TAILSCALE_HOSTNAME=usaaboo-connect

# ── OmniRoute ───────────────────────────────────────────────
OMNIROUTE_API_KEY=your-omniroute-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
STORAGE_ENCRYPTION_KEY=your-encryption-key

# ── Trinity ─────────────────────────────────────────────────
TRINITY_REDIS_PASSWORD=your-redis-password
TRINITY_INTERNAL_API_SECRET=your-internal-api-secret

# ── Hermes ──────────────────────────────────────────────────
HERMES_DEFAULT_PROVIDER=nous
HERMES_DEFAULT_MODEL=tencent/hy3:free
HERMES_BASE_URL=https://inference-api.nousresearch.com/v1

# ── Ollama ──────────────────────────────────────────────────
OLLAMA_HOST=127.0.0.1:11434

# ── Soup (ML Training) ─────────────────────────────────────
SOUP_MODEL_ID=HuggingFaceTB/SmolLM2-135M
SOUP_SERVE_PORT=11435
SOUP_VENV=/home/ubuntu/.venvs/soup

# ── Nginx / HTTPS ──────────────────────────────────────────
DOMAIN=usaaboo-connect.tail22c6ab.ts.net
# Set to 'tailscale' for Tailscale certs, 'letsencrypt' for certbot, 'self-signed' for dev
SSL_PROVIDER=tailscale